  {
   "id": "nawarat-bridge",
   "type": "bridge",
   "names": {
    "name": "Nawarat Bridge",
    "th": "สะพานนวรัฐ",
    "rtgs": "Saphan Nawarat",
    "aliases": [
     "ขัวแขก"
    ],
    "said": "Teak about 1890, steel 1923 after the teak burned, concrete 1967. The gauge that read 5.30 m is on it.",
    "said_th": "ไม้สักราว 2433 เหล็ก 2466 หลังไม้ไหม้ คอนกรีต 2510 สถานีวัดน้ำตี้อ่านได้ 5.30 เมตรอยู่บนมัน"
   },
   "region": [
    "ring1"
   ],
   "facets": {
    "era": "superhighway",
    "year": "1967"
   },
   "text": {
    "what": "The bridge at the foot of Tha Phae Road, named for Chao Kaew Nawarat, the last ruler. A teak bridge about 1890; a steel one begun 1921 after the wooden one burned and opened 1923; the present reinforced-concrete bridge completed 1967 and opened 26 December that year. The Ping gauge P.1 is here, and it read 5.30 m at noon on 5 October 2024."
   },
   "text_th": {
    "what": "ขัวตีนถนนท่าแพ ตั้งชื่อตามเจ้าแก้วนวรัฐ เจ้าหลวงองค์สุดท้าย ขัวไม้สักราว 2433 ขัวเหล็กเริ่ม 2464 หลังขัวไม้ไหม้ เปิด 2466 ขัวคอนกรีตเสริมเหล็กปัจจุบันเสร็จ 2510 เปิด 26 ธันวาคมปีนั้น สถานีวัดน้ำ P.1 อยู่ตรงนี้ และอ่านได้ 5.30 เมตรตอนเที่ยง 5 ตุลาคม 2567"
   },
   "road": {
    "opened": "1967-12-26",
    "osm_names": [
