 "names": {
  "name": "Nimmanhaemin Road",
  "th": "ถนนนิมมานเหมินท์",
  "rtgs": "Thanon Nimmanhemin",
  "aliases": [
   "Nimman"
  ],
  "said": "1.327 km, given away in 1963, and the most expensive strip of ground in the north.",
  "said_th": "1.327 กิโล หื้อไปปี 2506 และเป็นแถบดินแพงสุดของภาคเหนือ"
 },
 "region": [
  "ring1"
 ],
 "facets": {
  "era": "superhighway",
  "km": 1.327
 },
 "text": {
  "what": "1.327 km between Huay Kaew and Suthep roads, on the edge of the land Ki and Kim Ho Nimmanhaemin gave for the university in 1963. It was later absorbed into Route 11 as the western arc of the first ring, and handed back to the municipality in June 2022. Commercial from about 1987; the Soi 1 festival began 1999; assessed land value in 2019 was 180,000 baht a square wa, about 72 million baht a rai.",
  "story": "*Inference —* it is a road named for a gift and priced like a mine. The sois off it are numbered 1 to 17 and each is a small economy; the lane page counts them."
 },
 "text_th": {
  "what": "1.327 กม. ระหว่างถนนห้วยแก้วกับถนนสุเทพ บนขอบที่ดินที่กี กับ กิมฮ้อ นิมมานเหมินท์ มอบให้มหาวิทยาลัยปี 2506 ต่อมาถูกรวมเป็นส่วนของทางหลวง 11 เป็นส่วนโค้งตะวันตกของวงแหวนรอบแรก และคืนให้เทศบาลมิถุนายน 2565 เป็นย่านค้าตั้งแต่ราวปี 2530 เทศกาลซอย 1 เริ่ม 2542 ราคาประเมินปี 2562 ตารางวาละ 180,000 บาท ราวไร่ละ 72 ล้าน",
  "story": "*อนุมาน —* เป็นถนนที่ตั้งชื่อตามของขวัญ และราคาเหมือนเหมือง ซอยที่แยกออกไปมีเลข 1 ถึง 17 และแต่ละซอยคือเศรษฐกิจย่อม ๆ หน้าฮ่อมนับไว้"
 },
